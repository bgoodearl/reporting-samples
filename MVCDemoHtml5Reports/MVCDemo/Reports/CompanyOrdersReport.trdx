<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="objectDataSource1" Width="7.458in" SkipBlankPages="False" Name="CompanyOrdersReport" xmlns="http://schemas.telerik.com/reporting/2025/1.0">
  <DataSources>
    <ObjectDataSource ParameterValues="null" DataMember="GetCustomerCompaniesAndOrders" Name="objectDataSource1">
      <DataSource>
        <ClrType FullName="Northwind.ReportHelper.NorthwindObjectSource" Assembly="Northwind.ReportHelper, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
      </DataSource>
      <Parameters>
        <ObjectDataSourceParameter Name="contactTitle">
          <DataType>System.String</DataType>
          <Value>
            <String>= Parameters.contactTitle.Value</String>
          </Value>
        </ObjectDataSourceParameter>
      </Parameters>
    </ObjectDataSource>
  </DataSources>
  <Items>
    <PageHeaderSection Height="0.281in" Name="pageHeader">
      <Items>
        <TextBox Width="7.417in" Height="0.2in" Left="0.021in" Top="0.021in" Value="CompanyOrdersReport" Name="reportNameTextBox" StyleName="PageInfo" />
      </Items>
    </PageHeaderSection>
    <PageFooterSection Height="0.281in" Name="pageFooter">
      <Items>
        <TextBox Width="3.698in" Height="0.2in" Left="0.021in" Top="0.021in" Value="=NOW()" Name="currentTimeTextBox" StyleName="PageInfo" />
        <TextBox Width="3.698in" Height="0.2in" Left="3.74in" Top="0.021in" Value="=PageNumber" Name="pageInfoTextBox" StyleName="PageInfo">
          <Style TextAlign="Right" />
        </TextBox>
      </Items>
    </PageFooterSection>
    <ReportHeaderSection Height="0.808in" Name="reportHeader">
      <Items>
        <TextBox Width="7.458in" Height="0.787in" Left="0in" Top="0in" Value="CompanyOrdersReport" Name="titleTextBox" StyleName="Title" />
      </Items>
    </ReportHeaderSection>
    <ReportFooterSection Height="0.281in" Name="reportFooter" />
    <DetailSection Height="0.281in" Name="detail">
      <Items>
        <TextBox Width="1.467in" Height="0.2in" Left="3.187in" Top="0.021in" Value="= Fields.ContactName" CanGrow="True" Name="contactNameDataTextBox" StyleName="Data" />
        <TextBox Width="1.467in" Height="0.2in" Left="4.675in" Top="0.021in" Value="= Fields.Phone" CanGrow="True" Name="phoneDataTextBox" StyleName="Data" />
        <TextBox Width="1.467in" Height="0.2in" Left="1.7in" Top="0.021in" Value="= Fields.CompanyName" CanGrow="True" Name="textBox3" StyleName="Data" />
      </Items>
    </DetailSection>
  </Items>
  <PageSettings PaperKind="Letter" Landscape="False">
    <Margins>
      <MarginsU Left="0.5in" Right="0.5in" Top="0.75in" Bottom="1in" />
    </Margins>
  </PageSettings>
  <StyleSheet>
    <StyleRule>
      <Style>
        <Padding Left="2pt" Right="2pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextItemBase" />
        <TypeSelector Type="HtmlTextBox" />
      </Selectors>
    </StyleRule>
    <StyleRule>
      <Style Color="28, 58, 112">
        <Font Name="Tahoma" Size="18pt" />
      </Style>
      <Selectors>
        <StyleSelector Type="ReportItemBase" StyleName="Title" />
      </Selectors>
    </StyleRule>
    <StyleRule>
      <Style BackgroundColor="28, 58, 112" Color="White" VerticalAlign="Middle">
        <Font Name="Tahoma" Size="10pt" />
      </Style>
      <Selectors>
        <StyleSelector Type="ReportItemBase" StyleName="Caption" />
      </Selectors>
    </StyleRule>
    <StyleRule>
      <Style Color="Black" VerticalAlign="Middle">
        <Font Name="Tahoma" Size="9pt" />
      </Style>
      <Selectors>
        <StyleSelector Type="ReportItemBase" StyleName="Data" />
      </Selectors>
    </StyleRule>
    <StyleRule>
      <Style Color="Black" VerticalAlign="Middle">
        <Font Name="Tahoma" Size="8pt" />
      </Style>
      <Selectors>
        <StyleSelector Type="ReportItemBase" StyleName="PageInfo" />
      </Selectors>
    </StyleRule>
  </StyleSheet>
  <Groups>
    <Group Name="labelsGroup">
      <GroupHeader>
        <GroupHeaderSection PrintOnEveryPage="True" Height="0.281in" Name="labelsGroupHeaderSection">
          <Items>
            <TextBox Width="1.467in" Height="0.2in" Left="0.021in" Top="0.021in" Value="Contact Title / Country" CanGrow="True" Name="contactTitleCaptionTextBox" StyleName="Caption" />
            <TextBox Width="1.467in" Height="0.2in" Left="1.7in" Top="0.021in" Value="Company Name" CanGrow="True" Name="companyNameCaptionTextBox" StyleName="Caption" />
            <TextBox Width="1.467in" Height="0.2in" Left="3.187in" Top="0.021in" Value="Contact Name" CanGrow="True" Name="contactNameCaptionTextBox" StyleName="Caption" />
            <TextBox Width="1.467in" Height="0.2in" Left="4.675in" Top="0.021in" Value="Phone" CanGrow="True" Name="phoneCaptionTextBox" StyleName="Caption" />
          </Items>
        </GroupHeaderSection>
      </GroupHeader>
      <GroupFooter>
        <GroupFooterSection Height="0.281in" Name="labelsGroupFooterSection">
          <Style Visible="False" />
        </GroupFooterSection>
      </GroupFooter>
    </Group>
    <Group Name="contactTitleGroup">
      <GroupHeader>
        <GroupHeaderSection Height="0.281in" Name="contactTitleGroupHeaderSection">
          <Items>
            <TextBox Width="1.467in" Height="0.2in" Left="0.021in" Top="0.021in" Value="= Fields.ContactTitle" CanGrow="True" Name="textBox1" StyleName="Data" />
          </Items>
        </GroupHeaderSection>
      </GroupHeader>
      <GroupFooter>
        <GroupFooterSection Height="0.281in" Name="contactTitleGroupFooterSection">
          <Style Visible="False" />
        </GroupFooterSection>
      </GroupFooter>
      <Groupings>
        <Grouping Expression="= Fields.ContactTitle" />
      </Groupings>
    </Group>
    <Group Name="countryGroup">
      <GroupHeader>
        <GroupHeaderSection Height="0.281in" Name="countryGroupHeaderSection">
          <Items>
            <TextBox Width="1.467in" Height="0.2in" Left="0.6in" Top="0.021in" Value="= Fields.Country" CanGrow="True" Name="textBox2" StyleName="Data" />
          </Items>
        </GroupHeaderSection>
      </GroupHeader>
      <GroupFooter>
        <GroupFooterSection Height="0.281in" Name="countryGroupFooterSection" />
      </GroupFooter>
      <Groupings>
        <Grouping Expression="= Fields.Country" />
      </Groupings>
    </Group>
  </Groups>
  <ReportParameters>
    <ReportParameter Name="contactTitle" Text="Contact Title" AllowNull="True">
      <Value>
        <String>="Marketing Manager"</String>
      </Value>
    </ReportParameter>
  </ReportParameters>
</Report>